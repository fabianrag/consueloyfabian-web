---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ornament from "../components/Ornament.astro";
import { pick } from "../lib/photos";

const [hero] = pick("matri-088");
const [fotoGracias, fotoInvitacion, fotoGaleria] = pick(
  "matri-071",
  "matri-086",
  "matri-090",
);

const secciones = [
  {
    href: "/matrimonio/inicio",
    etiqueta: "Gracias",
    titulo: "Nuestro matrimonio",
    texto: "Unas palabras para quienes nos acompañaron.",
    foto: fotoGracias,
  },
  {
    href: "/matrimonio/invitacion",
    etiqueta: "El recuerdo",
    titulo: "La invitación",
    texto: "Así los invitamos a celebrar con nosotros.",
    foto: fotoInvitacion,
  },
  {
    href: "/matrimonio/galeria",
    etiqueta: "Fotografías",
    titulo: "La galería",
    texto: "Todos los momentos de ese día, foto a foto.",
    foto: fotoGaleria,
  },
];
---

<BaseLayout title="Consuelo y Fabián">
  <section class="hero">
    <div class="hero__text">
      <p class="eyebrow rise">19 · 10 · 2024 — Coquimbo, Chile</p>
      <h1 class="hero__names rise" style="--i:1">
        Consuelo <span class="hero__amp">&amp;</span> Fabián
      </h1>
      <Ornament class="rise" />
      <p class="hero__lead rise" style="--i:2">
        Bienvenidos a nuestro rincón. Aquí guardamos los recuerdos del día en
        que nos dijimos que sí.
      </p>
      <div class="hero__actions rise" style="--i:3">
        <a href="/matrimonio/galeria" class="btn btn--gold">
          Ver la galería
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="/matrimonio/inicio" class="btn btn--ghost">Nuestro matrimonio</a>
      </div>
    </div>

    {hero && (
      <figure class="hero__photo rise" style="--i:1">
        <img
          src={hero.thumbnail}
          srcset={`${hero.thumbnail} 800w, ${hero.original} ${hero.width}w`}
          sizes="(max-width: 860px) 80vw, 440px"
          width={hero.width}
          height={hero.height}
          alt="Consuelo y Fabián besándose el día de su matrimonio"
          fetchpriority="high"
        />
      </figure>
    )}
  </section>

  <section class="secciones" aria-labelledby="secciones-titulo">
    <div class="secciones__head">
      <p class="eyebrow">Recorre</p>
      <h2 id="secciones-titulo" class="script">Nuestro gran día</h2>
    </div>
    <ul class="secciones__grid">
      {secciones.map(({ href, etiqueta, titulo, texto, foto }) => (
        <li>
          <a href={href} class="tarjeta">
            {foto && (
              <img
                src={foto.thumbnail}
                width={foto.width}
                height={foto.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="tarjeta__body">
              <p class="eyebrow">{etiqueta}</p>
              <h3>{titulo}</h3>
              <p>{texto}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    width: var(--page);
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 5rem) 0 clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.35rem;
  }

  .hero__names {
    font-family: var(--font-script);
    font-weight: 400;
    font-size: clamp(3.6rem, 8.2vw, 6.6rem);
    line-height: 0.98;
    color: var(--gold-100);
    text-shadow: 0 2px 30px rgba(200, 162, 74, 0.25);
  }

  .hero__amp {
    display: block;
    font-size: 0.55em;
    line-height: 1.1;
    color: var(--gold);
    padding-left: 0.6em;
  }

  .hero__lead {
    max-width: 30ch;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-style: italic;
    color: var(--on-navy);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }

  /* Foto en arco con doble filete dorado */
  .hero__photo {
    position: relative;
    justify-self: center;
    width: min(100%, 440px);
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px var(--radius) var(--radius);
    box-shadow: var(--shadow);
  }

  .hero__photo::before {
    content: "";
    position: absolute;
    inset: -12px;
    border: 1px solid rgba(200, 162, 74, 0.6);
    border-radius: inherit;
    pointer-events: none;
  }

  .hero__photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 48% 30%;
    border-radius: inherit;
    border: 3px solid var(--gold);
  }

  /* ── Secciones ── */
  .secciones {
    width: var(--page);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) 0 1rem;
  }

  .secciones__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
  }

  .secciones__head h2 {
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    color: var(--gold-200);
  }

  .secciones__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .tarjeta {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    border: 1px solid rgba(200, 162, 74, 0.4);
    background: var(--navy-700);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.7);
    transition:
      transform 0.4s var(--ease),
      border-color 0.3s;
  }

  .tarjeta img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .tarjeta::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 18, 38, 0) 35%,
      rgba(8, 18, 38, 0.6) 62%,
      rgba(8, 18, 38, 0.94)
    );
  }

  .tarjeta__body {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.4rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .tarjeta__body .eyebrow {
    font-size: 0.68rem;
    color: var(--gold-200);
  }

  .tarjeta h3 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .tarjeta__body p:last-child {
    font-size: 1.05rem;
    line-height: 1.35;
    color: #dfe3ee;
  }

  .tarjeta:hover {
    transform: translateY(-4px);
    border-color: var(--gold);
  }

  .tarjeta:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: 2.5rem;
    }

    .hero__photo {
      order: -1;
      width: min(78%, 340px);
    }

    .hero__text {
      align-items: center;
    }

    .hero__amp {
      padding-left: 0;
    }

    .hero__actions {
      justify-content: center;
    }

    .secciones__grid {
      grid-template-columns: 1fr;
      width: min(100%, 460px);
      margin: 0 auto;
    }

    .tarjeta {
      aspect-ratio: 16 / 11;
    }
  }
</style>
