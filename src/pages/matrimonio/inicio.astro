---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Ornament from "../../components/Ornament.astro";
import { pick, photos } from "../../lib/photos";

const momentos = pick(
  "matri-082",
  "matri-069",
  "matri-072",
  "matri-090",
  "matri-104",
  "matri-218",
);
---

<BaseLayout title="Gracias por acompañarnos">
  <section id="agradecimiento" class="paper">
    <div class="paper__inner">
      <img
        src="/images/flor-superior-derecha.webp"
        alt=""
        class="paper__flor paper__flor--tr"
        width="313"
        height="288"
      />
      <img
        src="/images/flor-inferior-izquierda.webp"
        alt=""
        class="paper__flor paper__flor--bl"
        width="300"
        height="300"
      />
      <p class="eyebrow">19 de octubre de 2024</p>
      <h1 class="gracias__titulo script">¡Muchas gracias!</h1>
      <p class="gracias__sub">A todos quienes nos acompañaron</p>
      <Ornament />
      <p class="gracias__texto">
        Nos sentimos muy felices de haber contado con tu presencia en este
        momento tan importante de nuestras vidas.
      </p>
      <p class="gracias__texto">
        ¡Esperamos seguir compartiendo juntos en el futuro!
      </p>
      <a href="/matrimonio/galeria" class="btn btn--gold gracias__cta">
        Ver galería
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </section>

  {momentos.length > 0 && (
    <section class="momentos" aria-labelledby="momentos-titulo">
      <div class="momentos__head">
        <p class="eyebrow">Algunos momentos</p>
        <h2 id="momentos-titulo" class="script">Recuerdos de ese día</h2>
      </div>
      <ul class="momentos__grid">
        {momentos.map((foto) => (
          <li>
            <a href="/matrimonio/galeria" aria-label="Ver la galería completa">
              <img
                src={foto.thumbnail}
                width={foto.width}
                height={foto.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))}
      </ul>
      <a href="/matrimonio/galeria" class="btn btn--ghost">
        Ver las {photos.length} fotos
      </a>
    </section>
  )}
</BaseLayout>

<style>
  .gracias__titulo {
    margin-top: 0.75rem;
    font-size: clamp(3rem, 11vw, 4.6rem);
    color: var(--gold-700);
  }

  .gracias__sub {
    margin: 0.5rem 0 1.25rem;
    font-size: clamp(1.3rem, 4vw, 1.6rem);
    font-weight: 500;
    color: var(--ink);
  }

  .gracias__texto {
    max-width: 34ch;
    margin-top: 1.1rem;
    color: var(--ink-soft);
  }

  .gracias__cta {
    margin-top: 2rem;
  }

  .momentos {
    width: var(--page);
    margin: clamp(1.5rem, 5vw, 3rem) auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    text-align: center;
  }

  .momentos__head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .momentos__head h2 {
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    color: var(--gold-200);
  }

  .momentos__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
  }

  .momentos__grid a {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    border: 1px solid rgba(200, 162, 74, 0.35);
    background: var(--navy-700);
  }

  .momentos__grid li:nth-child(even) {
    transform: translateY(14px);
  }

  .momentos__grid img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .momentos__grid a:hover img {
    transform: scale(1.06);
  }

  @media (max-width: 760px) {
    .momentos__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .momentos__grid li:nth-child(even) {
      transform: none;
    }
  }
</style>
