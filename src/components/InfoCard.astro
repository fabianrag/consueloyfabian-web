---
const { id, icon, iconAlt = "", title } = Astro.props;
---

<section id={id} class="info">
  <div class="info__icon">
    <img src={icon} alt={iconAlt} width="44" height="44" loading="lazy" />
  </div>
  <h2 class="script">{title}</h2>
  <div class="info__body">
    <slot />
  </div>
</section>

<style>
  .info {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 2.6rem 1.6rem 2rem;
    text-align: center;
    color: var(--ink);
    background: var(--paper);
    border-radius: var(--radius);
    box-shadow: 0 18px 44px -24px rgba(0, 0, 0, 0.7);
  }

  .info::before {
    content: "";
    position: absolute;
    inset: 7px;
    border: 1px solid rgba(200, 162, 74, 0.55);
    border-radius: calc(var(--radius) - 6px);
    pointer-events: none;
  }

  .info__icon {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--gold);
    box-shadow: 0 0 0 5px var(--paper-edge);
  }

  .info__icon img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .info h2 {
    margin-top: 0.5rem;
    font-size: 2.5rem;
    color: var(--gold-700);
  }

  .info__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .info__body :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }
</style>
