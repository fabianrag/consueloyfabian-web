---
const currentPath = Astro.url.pathname;

const isHome = currentPath === "/";
const isMatrimonio = currentPath.startsWith("/matrimonio");
const isMatrimonioInicio = currentPath === "/matrimonio/inicio";
const isMatrimonioInvitacion = currentPath === "/matrimonio/invitacion";
const isMatrimonioGaleria = currentPath === "/matrimonio/galeria";

const mainLinks = [
  { href: "/", label: "Inicio", active: isHome },
  { href: "/matrimonio/inicio", label: "Matrimonio", active: isMatrimonio },
];

const matrimonioLinks = [
  { href: "/matrimonio/inicio", label: "Inicio", active: isMatrimonioInicio },
  { href: "/matrimonio/invitacion", label: "Invitación", active: isMatrimonioInvitacion },
  { href: "/matrimonio/galeria", label: "Galería", active: isMatrimonioGaleria },
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-logo" aria-label="Consuelo y Fabián — ir al inicio">
      <span class="site-logo__full">Consuelo &amp; Fabián</span>
      <span class="site-logo__short" aria-hidden="true">C &amp; F</span>
    </a>

    <nav class="main-nav" aria-label="Navegación principal">
      <ul class="main-nav-list">
        {mainLinks.map(({ href, label, active }) => (
          <li>
            <a
              href={href}
              class:list={["nav-link", { "nav-link--active": active }]}
              aria-current={active ? (href === currentPath ? "page" : "true") : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/finanzas/" class="finanzas-link" aria-label="Finanzas (acceso privado)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>Finanzas</span>
    </a>
  </div>

  {isMatrimonio && (
    <nav class="sub-nav" aria-label="Sección matrimonio">
      <ul class="sub-nav-list">
        {matrimonioLinks.map(({ href, label, active }) => (
          <li>
            <a
              href={href}
              class:list={["sub-link", { "sub-link--active": active }]}
              aria-current={active ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(11, 23, 48, 0.82);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid rgba(200, 162, 74, 0.35);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    min-height: 60px;
    padding: 0 clamp(0.9rem, 3vw, 2rem);
  }

  .site-logo {
    justify-self: start;
    font-family: var(--font-script);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--gold-200);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.4rem 0;
    transition: color 0.2s;
  }

  .site-logo:hover {
    color: #fff3cf;
  }

  .site-logo__short {
    display: none;
  }

  /* ── Navegación principal ── */
  .main-nav-list,
  .sub-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .main-nav-list {
    gap: clamp(0.25rem, 2vw, 1.5rem);
  }

  .nav-link {
    position: relative;
    display: block;
    padding: 1.2rem 0.6rem;
    color: var(--on-navy);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.85rem;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform 0.3s var(--ease);
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--gold-200);
  }

  .nav-link:hover::after,
  .nav-link--active::after {
    transform: scaleX(1);
  }

  /* ── Acceso discreto a Finanzas (privado) ── */
  .finanzas-link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 34px;
    padding: 0.3rem 0.85rem;
    color: var(--on-navy-soft);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid rgba(239, 232, 211, 0.2);
    border-radius: 999px;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }

  .finanzas-link svg {
    width: 13px;
    height: 13px;
  }

  .finanzas-link:hover {
    color: var(--gold-200);
    border-color: var(--gold);
    background: rgba(200, 162, 74, 0.1);
  }

  /* ── Subnavegación matrimonio ── */
  .sub-nav {
    display: flex;
    justify-content: center;
    padding: 0.45rem 0.75rem 0.6rem;
    border-top: 1px solid rgba(239, 232, 211, 0.08);
  }

  .sub-nav-list {
    gap: 2px;
    padding: 3px;
    border: 1px solid rgba(200, 162, 74, 0.4);
    border-radius: 999px;
    background: rgba(8, 18, 38, 0.6);
  }

  .sub-link {
    display: block;
    padding: 0.35rem 1.15rem;
    color: var(--on-navy);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    border-radius: 999px;
    transition: background-color 0.2s, color 0.2s;
  }

  .sub-link:hover {
    background: rgba(234, 217, 164, 0.14);
    color: var(--gold-200);
  }

  .sub-link--active,
  .sub-link--active:hover {
    background: linear-gradient(135deg, #e6cf8d, var(--gold));
    color: var(--navy-900);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .header-inner {
      min-height: 52px;
    }

    .site-logo {
      font-size: 1.6rem;
    }

    .site-logo__full {
      display: none;
    }

    .site-logo__short {
      display: inline;
    }

    .nav-link {
      padding: 1rem 0.45rem;
      font-size: 0.72rem;
      letter-spacing: 0.16em;
    }

    .nav-link::after {
      left: 0.45rem;
      right: 0.45rem;
      bottom: 0.7rem;
    }

    .finanzas-link {
      width: 34px;
      padding: 0;
      justify-content: center;
    }

    .finanzas-link span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .sub-link {
      padding: 0.3rem 0.95rem;
      font-size: 1rem;
    }
  }
</style>
