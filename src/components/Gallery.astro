---
import type { GalleryItem } from "../lib/photos";

interface Props {
  id?: string;
  items: GalleryItem[];
}

const { id = "pswp-gallery", items } = Astro.props;

// Las primeras filas se cargan de inmediato; el resto, al acercarse.
const EAGER = 8;
---

<section class="gallery-section">
  <div id={id} class="thumbnail-grid pswp-gallery">
    {items.map((it, i) => {
      const ratio = (it.width / it.height).toFixed(4);
      const label = it.caption || `Foto ${i + 1} de ${items.length}`;
      return (
        <a
          href={it.original}
          style={`--r:${ratio}`}
          data-pswp-width={it.width}
          data-pswp-height={it.height}
          data-pswp-srcset={`${it.thumbnail} 800w, ${it.original} ${it.width}w`}
          aria-label={`Ampliar: ${label}`}
        >
          <img
            src={it.thumbnail}
            width={it.width}
            height={it.height}
            alt={label}
            loading={i < EAGER ? "eager" : "lazy"}
            decoding="async"
            fetchpriority={i === 0 ? "high" : undefined}
            class="thumbnail"
          />
        </a>
      );
    })}
  </div>
</section>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  document.querySelectorAll<HTMLElement>(".pswp-gallery").forEach((el) => {
    const lightbox = new PhotoSwipeLightbox({
      gallery: el,
      children: "a",
      pswpModule: () => import("photoswipe"),
      showHideAnimationType: "zoom",
      wheelToZoom: true,
      preload: [1, 2],
      secondaryZoomLevel: 1.5,
      bgOpacity: 0.94,
    });
    lightbox.init();
  });
</script>

<style>
  .gallery-section {
    width: min(1500px, 100% - 1.5rem);
    margin: 0 auto;
  }

  /* Mosaico justificado solo con CSS: cada foto crece en proporción a su
     relación de aspecto, así todas las de una fila quedan con igual altura. */
  .thumbnail-grid {
    --row: 230px;
    --gap: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
  }

  .thumbnail-grid::after {
    content: "";
    flex-grow: 1000000;
  }

  .thumbnail-grid a {
    position: relative;
    display: block;
    overflow: hidden;
    flex: var(--r) var(--r) calc(var(--r) * var(--row));
    aspect-ratio: var(--r);
    border-radius: 10px;
    background: linear-gradient(135deg, var(--navy-700), var(--navy-800));
  }

  .thumbnail-grid a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(234, 217, 164, 0);
    transition: box-shadow 0.3s;
    pointer-events: none;
  }

  .thumbnail-grid a:hover::after,
  .thumbnail-grid a:focus-visible::after {
    box-shadow: inset 0 0 0 2px var(--gold);
  }

  .thumbnail {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .thumbnail-grid a:hover .thumbnail {
    transform: scale(1.05);
  }

  @media (max-width: 1024px) {
    .thumbnail-grid {
      --row: 170px;
    }
  }

  @media (max-width: 600px) {
    .thumbnail-grid {
      --row: 108px;
      --gap: 5px;
    }

    .thumbnail-grid a {
      border-radius: 6px;
    }
  }
</style>
